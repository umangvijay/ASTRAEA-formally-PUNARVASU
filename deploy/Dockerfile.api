# Cloud Run / GCE — API only. Vertex uses ADC on the metadata server.
FROM python:3.12-slim-bookworm

WORKDIR /app
RUN mkdir -p /app/data
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend \
    PORT=8080 \
    ASTRAEA_EMBEDDER=hash

RUN apt-get update && apt-get install -y --no-install-recommends \
      libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.cloud.txt /app/backend/requirements.cloud.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.cloud.txt

COPY backend /app/backend
COPY docs /app/docs

EXPOSE 8080
# Do not block PORT on alembic — create_all in lifespan creates sqlite tables.
# A hanging Cloud SQL URL used to never bind, and Cloud Run returned HTML 500.
CMD ["sh", "-c", "exec python -m uvicorn app.cloud_run:app --host 0.0.0.0 --port ${PORT:-8080}"]
