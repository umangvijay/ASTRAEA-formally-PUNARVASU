# ══════════════════════════════════════════════════════════════════
#  ASTRAEA — control plane for autonomous agents
#  Copy this file to .env  →  cp .env.example .env
#  Canonical prefix: ASTRAEA_  (legacy PUNARVASU_* keys are auto-aliased)
# ══════════════════════════════════════════════════════════════════

# ─── Core settings ────────────────────────────────────────────────
ASTRAEA_ENV=dev
# Leave empty to auto-select: sqlite (single-node) / postgres (docker mode).
# Production: postgresql+psycopg://astra:astra@localhost:5432/punarvasu
ASTRAEA_DATABASE_URL=
# Cloud Run: PROJECT:REGION:INSTANCE — uses the /cloudsql unix socket (no public IP).
ASTRAEA_CLOUD_SQL_INSTANCE=
ASTRAEA_DATABASE_USER=astraea
ASTRAEA_DATABASE_PASSWORD=
ASTRAEA_DATABASE_NAME=astraea
# REQUIRED before real users:  python3 -c "import secrets; print(secrets.token_hex(32))"
ASTRAEA_JWT_SECRET=
ASTRAEA_BACKEND_PORT=8000
ASTRAEA_FRONTEND_PORT=3000
# Lock down CORS in production (comma-separated origins). Dev allows localhost:*.
# Cloud Run console origin, e.g. https://astraea-console-xxxxx.run.app
ASTRAEA_CORS_ORIGINS=
# When the console and API are different hosts (Cloud Run split):
ASTRAEA_PUBLIC_API_URL=

# ─── Model keys (the platform works without any of these) ──────────
# Vertex AI — GCloud deploy. ADC / access token, or an API key on the project.
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT
ASTRAEA_VERTEX_PROJECT=
ASTRAEA_VERTEX_LOCATION=us-central1
ASTRAEA_VERTEX_ACCESS_TOKEN=   # optional: gcloud auth print-access-token
ASTRAEA_VERTEX_API_KEY=        # optional if ADC / access token is set
ASTRAEA_VERTEX_DEFAULT_MODEL=gemini-2.5-flash
# Gemini AI Studio (same models, billed to a Studio key — local / offline-adjacent)
ASTRAEA_GEMINI_API_KEY=   # https://aistudio.google.com/apikey  (free tier)
# Anthropic Claude (optional cloud brain)
ASTRAEA_ANTHROPIC_API_KEY=
ASTRAEA_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
# Groq — instant Llama 3.3 + free Whisper STT (VAANI)
ASTRAEA_GROQ_API_KEY=     # https://console.groq.com/keys       (free tier)
# HuggingFace — ONNX guardrail classifiers, OmniParser weights, datasets
ASTRAEA_HF_TOKEN=         # https://huggingface.co/settings/tokens (read token)
# Provider order — first ready wins. Offline: ollama / model_forge / mlx_local.
ASTRAEA_LLM_PROVIDER_ORDER=vertex,gemini,anthropic,groq,ollama,model_forge,mlx_local

# ─── OPERATOR live web (search / fetch / research) ────────────────
# DuckDuckGo is the zero-key default. Brave is optional and more stable.
ASTRAEA_BRAVE_API_KEY=    # https://brave.com/search/api/

# ─── Local fallbacks (no key, no cost) ────────────────────────────
# Ollama: https://ollama.com
#   ollama pull qwen2.5vl:7b qwen2.5-coder:7b llama3.2 nomic-embed-text
# Every cloud model in Astraea MUST have a local fallback route.

# ─── Optional integrations ────────────────────────────────────────
# ASTRAEA_GITHUB_TOKEN=    # MEDIC opens real PRs when set (with ASTRAEA_GITHUB_REPO)
# ASTRAEA_GITHUB_REPO=     # e.g. umangvijay/astraea-demo
# ASTRAEA_CLICKHOUSE_URL=  # e.g. http://127.0.0.1:8123 — sqlite telemetry store when empty
# ASTRAEA_NEO4J_URL=       # e.g. http://127.0.0.1:7474 — postgres graph fallback when empty
